MS_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
MS_TRANSLATOR_API_KEY=
MS_TRANSLATOR_REGION=
MS_TRANSLATOR_API_VERSION=3.0

# Optional fallback when API translation is unavailable.
# Google Web Translate is always available as free fallback.

# --- AI Translation Provider ---
# API provider used for AI translation: gemini, openai, or ollama.
AI_POLISHER_PROVIDER=gemini

# --- Remote API Mode (Optional PC -> Laptop split) ---
CAPCAP_REMOTE_API_URL=http://127.0.0.1:8765
CAPCAP_REMOTE_API_TOKEN=
CAPCAP_REMOTE_API_HOST=0.0.0.0
CAPCAP_REMOTE_API_PORT=8765
CAPCAP_REMOTE_API_TIMEOUT=600

# --- Remote API Logging ---
# Set to true/1 to suppress verbose logs from the remote API server
CAPCAP_QUIET=false

# --- Transcription Engine ---
# Options: whisper (audio), sensevoice (CPU audio via sherpa-onnx), ocr (video subtitle)
TRANSCRIPTION_ENGINE=whisper
# GPU Whisper batching: auto selects 8 for approximately 6 GB+ VRAM and 4
# for lower/unknown VRAM. Set 0 to use the standard non-batched path.
CAPCAP_WHISPER_GPU_BATCHED=1
CAPCAP_WHISPER_GPU_BATCH_SIZE=auto
# OCR subtitle position: bottom, top, full
OCR_SUBTITLE_REGION=bottom
# OCR crop ratio for bottom region (0.05-0.95, default 0.25 = bottom 25%)
OCR_CROP_RATIO=0.25
# OCR subtitle rect (normalized: x,y,w,h). Overrides OCR_CROP_RATIO when set.
# OCR_SUBTITLE_RECT=0.0,0.75,1.0,0.25

# --- AI Translation Settings ---
# Provider: gemini (Google AI Studio), openai (OpenAI), ollama, or google (free web translate)
OPENAI_PROVIDER=google
# OPENAI_API_KEY=your_api_key_here        # Only needed for gemini / openai / ollama providers
# OPENAI_MODEL=gemma-4-31b-it             # Default for gemini (Google AI Studio)
# OPENAI_MODEL=gpt-4o-mini                # Default for openai
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   # Default for gemini
# OPENAI_BASE_URL=https://api.openai.com/v1/                                  # Default for openai
# OPENAI_BASE_URL=http://localhost:11434/v1                                   # Default for ollama
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
